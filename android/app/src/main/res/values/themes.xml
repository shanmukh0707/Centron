<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose draws everything, so this only needs to be a sane no-action-bar
      shell. Deliberately NOT com.google.android.material's Theme.Material3,
      which would pull in the whole Material Components view library for one
      style reference.
    -->
    <style name="Theme.Sentinel" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/background_dark</item>
    </style>
</resources>
